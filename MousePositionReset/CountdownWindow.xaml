<Window x:Class="MousePositionReset.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        Background="#0F0F14"
        Opacity="0.85"
        WindowStartupLocation="Manual">
    <Grid>
        <TextBlock x:Name="lblCountdown"
                   Text="Move mouse to target position...&#x0a;&#x0a;Capturing in 3"
                   Foreground="#6366F1"
                   FontFamily="Segoe UI Semibold"
                   FontWeight="Bold"
                   FontSize="37.33"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
    </Grid>
</Window>
