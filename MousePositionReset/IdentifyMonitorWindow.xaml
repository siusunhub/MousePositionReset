<Window x:Class="MousePositionReset.IdentifyMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Background="#18181C"
        Opacity="0.92"
        Width="190" Height="190"
        WindowStartupLocation="Manual">
    <Border BorderBrush="#6366F1" BorderThickness="4" Margin="5">
        <Canvas Width="170" Height="170" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Monitor Screen Outline -->
            <Rectangle Canvas.Left="32" Canvas.Top="42" Width="105" Height="68"
                       Stroke="White" StrokeThickness="7" RadiusX="3" RadiusY="3" Fill="Transparent"/>
            <!-- Stand Vertical Stem -->
            <Line X1="84.5" Y1="110" X2="84.5" Y2="128"
                  Stroke="White" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <!-- Stand Base -->
            <Line X1="56.5" Y1="128" X2="112.5" Y2="128"
                  Stroke="White" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Canvas>
    </Border>
</Window>
